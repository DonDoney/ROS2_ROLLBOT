<?xml version="1.0"?>
<!--
  ============================================================================
  01_un_eslabon.urdf — El URDF más sencillo posible
  ============================================================================
  Un robot es un ÁRBOL de eslabones (link) unidos por articulaciones (joint).
  Aquí hay solo dos eslabones:
      world  (vacío, referencia fija)
      base   (un cilindro gris)
  unidos por una articulación "fixed" (no se mueve).

  Visualizar (desde esta carpeta):
    ros2 launch brazo_description visualizar.launch.py modelo:=$(pwd)/01_un_eslabon.urdf
-->
<robot name="un_eslabon">

  <!-- Eslabón de referencia: no tiene geometría -->
  <link name="world"/>

  <link name="base">
    <!-- visual: lo que se DIBUJA -->
    <visual>
      <!-- origin desplaza la geometría respecto al marco del eslabón.
           El cilindro mide 0.1 m de alto y su centro está en su mitad:
           lo subimos 0.05 m para que se apoye sobre el suelo. -->
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.1"/>
      </geometry>
      <material name="gris">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>

    <!-- collision: la forma que se usa para detectar choques.
         Suele ser igual o más simple que la visual. -->
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- Articulación FIJA: base pegada al mundo -->
  <joint name="world_a_base" type="fixed">
    <parent link="world"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
