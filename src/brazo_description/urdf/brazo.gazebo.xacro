<?xml version="1.0"?>
<!--
  ============================================================================
  brazo.gazebo.xacro — Etiquetas específicas de Gazebo Harmonic
  ============================================================================
  Solo se incluye cuando modo_hardware == gazebo. Hace dos cosas:
    1) Carga el plugin gz_ros2_control, que arranca un controller_manager
       DENTRO de Gazebo y lee la configuración de controladores (YAML).
    2) Da colores a los eslabones (Gazebo ignora los <material> de RViz).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Macro corta para dar color a un eslabón en Gazebo -->
  <xacro:macro name="color_gz" params="eslabon r g b">
    <gazebo reference="${eslabon}">
      <visual>
        <material>
          <ambient>${r} ${g} ${b} 1</ambient>
          <diffuse>${r} ${g} ${b} 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="brazo_gazebo" params="prefijo:='' archivo_controladores">

    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <!-- YAML con joint_state_broadcaster y brazo_controller -->
        <parameters>${archivo_controladores}</parameters>
      </plugin>
    </gazebo>


    <xacro:color_gz eslabon="${prefijo}base_link" r="0.20" g="0.20" b="0.22"/>
    <xacro:color_gz eslabon="${prefijo}link_1"    r="0.95" g="0.45" b="0.10"/>
    <xacro:color_gz eslabon="${prefijo}link_2"    r="0.95" g="0.45" b="0.10"/>
    <xacro:color_gz eslabon="${prefijo}link_3"    r="0.75" g="0.75" b="0.78"/>
    <xacro:color_gz eslabon="${prefijo}link_4"    r="0.95" g="0.45" b="0.10"/>
    <xacro:color_gz eslabon="${prefijo}link_5"    r="0.75" g="0.75" b="0.78"/>
    <xacro:color_gz eslabon="${prefijo}link_6"    r="0.05" g="0.05" b="0.05"/>

  </xacro:macro>
</robot>
