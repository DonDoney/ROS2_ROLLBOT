<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!--
  package.xml — brazo_examples
  Programas de ejemplo para mover el brazo: Python (topics y acciones) y C++ (MoveIt).
-->
<package format="3">
  <name>brazo_examples</name>
  <version>0.1.0</version>
  <description>Ejemplos de programación del brazo ROLLBOT en Python y C++.</description>
  <maintainer email="dondoney@users.noreply.github.com">DonDoney</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- C++ -->
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>

  <!-- Python -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>brazo_moveit_config</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
