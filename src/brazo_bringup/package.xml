<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!--
  package.xml — brazo_bringup
  Paquete de "arranque": contiene los launch y la configuración de controladores
  que ponen en marcha el brazo con ros2_control (en modo mock o con el robot real).
-->
<package format="3">
  <name>brazo_bringup</name>
  <version>0.1.0</version>
  <description>Launch files y configuración de ros2_control del brazo ROLLBOT.</description>
  <maintainer email="dondoney@users.noreply.github.com">DonDoney</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>brazo_description</exec_depend>
  <exec_depend>brazo_hardware</exec_depend>               <!-- Plugin para el robot real -->
  <exec_depend>controller_manager</exec_depend>           <!-- ros2_control_node y spawner -->
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
