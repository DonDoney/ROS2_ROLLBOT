<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!--
  package.xml — brazo_gazebo
  Simulación del brazo en Gazebo Harmonic (la versión emparejada con ROS 2 Jazzy).
-->
<package format="3">
  <name>brazo_gazebo</name>
  <version>0.1.0</version>
  <description>Mundos y launch para simular el brazo ROLLBOT en Gazebo Harmonic con gz_ros2_control.</description>
  <maintainer email="dondoney@users.noreply.github.com">DonDoney</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>brazo_description</exec_depend>
  <exec_depend>brazo_bringup</exec_depend>          <!-- Reutiliza brazo_controladores.yaml -->
  <exec_depend>ros_gz_sim</exec_depend>             <!-- Lanzar Gazebo y crear (spawn) el robot -->
  <exec_depend>ros_gz_bridge</exec_depend>          <!-- Puente de topics Gazebo <-> ROS 2 -->
  <exec_depend>gz_ros2_control</exec_depend>        <!-- ros2_control dentro de Gazebo -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
