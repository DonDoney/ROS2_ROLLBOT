<?xml version="1.0"?>
<!--
  ============================================================================
  mundo_brazo.sdf — Mundo de Gazebo Harmonic para el brazo
  ============================================================================
  Un suelo, una luz y una mesa pequeña delante del robot para probar
  movimientos y colisiones. Los <plugin> son los "sistemas" de Gazebo:
    Physics          -> motor de física (gravedad, colisiones)
    UserCommands     -> permite crear/borrar modelos (lo usa el spawn)
    SceneBroadcaster -> envía la escena a la ventana gráfica
-->
<sdf version="1.9">
  <world name="mundo_brazo">

    <!-- Paso de física de 1 ms, tiempo real 1:1 -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.81</gravity>

    <!-- Luz tipo sol -->
    <light type="directional" name="sol">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <!-- Suelo infinito -->
    <model name="suelo">
      <static>true</static>
      <link name="link">
        <collision name="colision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mesa de pruebas delante del brazo (a 0.45 m en X) -->
    <model name="mesa">
      <static>true</static>
      <pose>0.45 0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="colision">
          <geometry><box><size>0.3 0.4 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.4 0.2</size></box></geometry>
          <material>
            <ambient>0.45 0.30 0.15 1</ambient>
            <diffuse>0.45 0.30 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
