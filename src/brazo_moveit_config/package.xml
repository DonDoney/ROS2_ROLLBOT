<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!--
  package.xml — brazo_moveit_config
  Configuración de MoveIt 2 para el brazo ROLLBOT (SRDF, cinemática, límites,
  controladores) y los launch para planificar con RViz.
-->
<package format="3">
  <name>brazo_moveit_config</name>
  <version>0.1.0</version>
  <description>Configuración de MoveIt 2 para el brazo ROLLBOT de 6 GDL.</description>
  <maintainer email="dondoney@users.noreply.github.com">DonDoney</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>brazo_description</exec_depend>
  <exec_depend>brazo_bringup</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>               <!-- Plugin KDL -->
  <exec_depend>moveit_planners</exec_depend>                 <!-- OMPL -->
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>        <!-- Plugin de RViz -->
  <exec_depend>moveit_setup_assistant</exec_depend>          <!-- Asistente gráfico (opcional) -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
